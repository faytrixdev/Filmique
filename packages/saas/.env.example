# Copier ce fichier vers .env et remplir. `packages/saas/.env` est ignoré par git.

# Neon (obligatoire pour tout ce qui touche la base)
DATABASE_URL=postgresql://user:pass@ep-xxx.eu-west-2.aws.neon.tech/dbname?sslmode=require

# Secret des sessions magic-link (générer: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
AUTH_SECRET=

# LLM du compose : gemini | anthropic | groq | nim | openai | mock
# Groq = recommandé pour tests/dev (free tier permanent, json_object fiable)
LLM_PROVIDER=groq
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b        # défaut ; voir console.groq.com pour les modèles actifs
# NIM_API_KEY=
# NIM_MODEL=meta/llama-3.3-70b-instruct
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=

# Voix réelle (sans clé → MockVoice, piste démo)
CARTESIA_API_KEY=

# Whop
WHOP_CHECKOUT_URL=https://whop.com/checkout/...
WHOP_WEBHOOK_SECRET=whsec_...

# Render — backend au choix par env : AWS Lambda OU GCP Cloud Run (Lambda gagne si les deux sont posés)

# --- AWS Lambda ---
REMOTION_LAMBDA_FUNCTION_NAME=
REMOTION_LAMBDA_SERVE_URL=
REMOTION_LAMBDA_BUCKET=
REMOTION_LAMBDA_REGION=eu-west-1
# AWS credentials du CLI render (lu par @remotion/lambda, pas par Next)
# AWS_ACCESS_KEY_ID= / AWS_SECRET_ACCESS_KEY= → plutôt dans ~/.aws/credentials

# --- GCP Cloud Run (alpha Remotion) ---
CLOUDRUN_SERVICE_NAME=
CLOUDRUN_SERVE_URL=              # ex. https://storage.googleapis.com/<bucket>/sites/<site>/index.html
CLOUDRUN_BUCKET=
CLOUDRUN_REGION=europe-west1
# + les variables GCP générées par l'installeur Cloud Shell (GOOGLE_CLIENT_EMAIL / GOOGLE_PRIVATE_KEY / GCP_PROJECT_ID …)

# Callback du render (commun à tous les backends)
EXPORT_CALLBACK_URL=http://localhost:3000/api/exports/lambda
EXPORT_CALLBACK_SECRET=

# --- GitHub Actions (recommandé sans carte bancaire) ---
# Repo public = rendus illimités gratuits ; repo privé ≈ 200 rendus/mois (included compute)
# PAT: scope "repo" + "workflow" → https://github.com/settings/tokens
# Repo secrets requis côté GitHub: EXPORT_CALLBACK_URL + EXPORT_CALLBACK_SECRET
GITHUB_RENDER_REPO=
GITHUB_RENDER_TOKEN=
# GITHUB_RENDER_WORKFLOW=saas-render.yml
# GITHUB_RENDER_REF=main
